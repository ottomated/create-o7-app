datasource db {
  provider = "sqlite"
}

generator kysely {
  provider = "prisma-kysely"

  output   = "../src/lib/server/db"
  fileName = "schema.d.ts"
}


model User {
	/// @kyselyType(`u_${string}`)
  id        String @id
  twitch_id String
  username  String

  sessions Session[]
}

model Session {
	/// @kyselyType(`s_${string}`)
  id         String @id
	/// @kyselyType(`u_${string}`)
  user_id    String
	/// @kyselyType(Uint8Array)
	hash       Bytes
	last_verified_at Int
	created_at Int

  user       User   @relation(fields: [user_id], references: [id])
}
